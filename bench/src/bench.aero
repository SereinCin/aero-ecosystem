// aero-bench: batch CSV pipeline
// Input: data.csv, one row per line: id,price_cents,qty,active
// Task: filter (active==1 && price_cents>5000), aggregate total += price_cents*qty, count++
// Output: count=<n> / total=<sum>  (must match the Python baselines)

fn parse_digits(s: str, from: i64, end: i64) -> i64 {
    let val = 0;
    let j = from;
    while (j < end) {
        let c = s[j];
        if ((c < 48) || (c > 57)) {
            break;
        }
        val = val * 10 + (c - 48);
        j = j + 1;
    }
    return val;
}

let content = read_file("data.csv");
let n = len(content);
let count = 0;
let total = 0;
let ls = 0;
let i = 0;
while (i <= n) {
    if ((i == n) || (content[i] == 10)) {
        let c1 = -1;
        let c2 = -1;
        let c3 = -1;
        let j = ls;
        while (j < i) {
            let ch = content[j];
            if (ch == 44) {
                if (c1 < 0) {
                    c1 = j;
                } else if (c2 < 0) {
                    c2 = j;
                } else {
                    c3 = j;
                }
            }
            j = j + 1;
        }
        if (c1 > 0) {
            let price = parse_digits(content, c1 + 1, c2);
            let qty = parse_digits(content, c2 + 1, c3);
            let active = parse_digits(content, c3 + 1, i);
            if (active == 1) {
                if (price > 5000) {
                    total = total + price * qty;
                    count = count + 1;
                }
            }
        }
        ls = i + 1;
    }
    i = i + 1;
}
print("count="); print(count); print("\n");
print("total="); print(total); print("\n");
